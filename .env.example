# Copy to .env.local and fill in — never commit real keys.

# --- LLM refinement (optional) ------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Email source (live mailbox mode) ------------------------------------
# How the pipeline finds the inbox. Choose ONE:
#   1) static bundle (default):
#        INBOX_SOURCE=sdoc-hackathon-bundle
#   2) HTTP inbox/score server (loader.py supports it):
#        INBOX_SOURCE=http://localhost:8080
#   3) real email account via IMAP (production mode — see pipeline/mailbox.py):
#        INBOX_SOURCE=imaps://USER:PASS@imap.gmail.com/INBOX
#        # or provide the pieces separately (prevents the password in the URL):
#        IMAP_HOST=imap.gmail.com
#        IMAP_USER=your.shipping.desk@company.com
#        IMAP_PASS=an-app-password
#        IMAP_MAILBOX=INBOX            # optional, default INBOX
#        IMAP_PORT=993                 # optional, default 993
#        IMAP_SSL=1                    # optional, default 1

# --- Continuous operation ------------------------------------------------
# Poll the inbox every N seconds and only pick up new mail:
#   python pipeline/run_pipeline.py --poll 60 --new-only
# (Gmail/Outlook: use an App Password for IMAP access.)